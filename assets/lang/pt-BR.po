#: src/options/options_panel.cpp:139
msgid "Every GBA pixel becomes an exact block of screen pixels, so nothing shimmers or blurs. Leaves a small border when the window is not an exact multiple."
msgstr "Cada pixel do GBA vira um bloco exato de pixels da tela, então nada tremula nem borra. Deixa uma pequena borda quando a janela não é um múltiplo exato."

#: src/options/options_panel.cpp:141
msgid "Fit to window"
msgstr "Ajustar à janela"

#: src/options/options_panel.cpp:142
msgid "Fills as much of the window as possible. Some pixels end up one screen pixel wider than others."
msgstr "Preenche o máximo possível da janela. Alguns pixels ficam um pixel de tela mais largos que outros."

#: src/options/options_panel.cpp:149
msgid "Widescreen view"
msgstr "Tela widescreen"

#: src/options/options_panel.cpp:153
msgid "Off (3:2)"
msgstr "Não (3:2)"

#: src/options/options_panel.cpp:164
msgid "Shows more of the level at the left and right instead of stretching the picture. Pixels always stay square, and the HUD stays where it was. Menus and the title screen stay 3:2."
msgstr "Mostra mais da fase à esquerda e à direita em vez de esticar a imagem. Os pixels continuam quadrados e o HUD fica no lugar. Menus e tela de título continuam em 3:2."

#: src/options/options_panel.cpp:170
msgid "Fullscreen"
msgstr "Tela cheia"

#: src/options/options_panel.cpp:174
msgid "F11 also switches fullscreen."
msgstr "F11 também alterna a tela cheia."

