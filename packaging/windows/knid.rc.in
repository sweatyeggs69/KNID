// Windows resources for KNID.exe (generated by CMake from packaging/windows/knid.rc.in).
#include <winver.h>

1 ICON "@CMAKE_CURRENT_BINARY_DIR@/knid.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "KNID project"
            VALUE "FileDescription",  "KNID - Kirby: Nightmare in Dream Land, native"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "InternalName",     "KNID"
            VALUE "LegalCopyright",   "Unofficial project. No game data included. Kirby is a trademark of Nintendo / HAL Laboratory."
            VALUE "OriginalFilename", "KNID.exe"
            VALUE "ProductName",      "KNID"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
